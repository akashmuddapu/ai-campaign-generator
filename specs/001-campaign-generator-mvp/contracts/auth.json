{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auth API Contracts",
  "description": "Endpoints for user registration, authentication, session state, and logout",
  "endpoints": {
    "signup": {
      "method": "POST",
      "path": "/api/auth/signup",
      "request": {
        "type": "object",
        "required": ["email", "password", "name"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 },
          "name": { "type": "string", "minLength": 2 }
        }
      },
      "responses": {
        "201": {
          "description": "User created and authenticated",
          "body": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "example": "success" },
              "user": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "email": { "type": "string" },
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "400": {
          "description": "Validation error or email already registered"
        }
      }
    },
    "login": {
      "method": "POST",
      "path": "/api/auth/login",
      "request": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "responses": {
        "200": {
          "description": "Successfully authenticated; session cookie set",
          "body": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "example": "success" },
              "user": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "email": { "type": "string" },
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "401": {
          "description": "Invalid credentials"
        }
      }
    },
    "logout": {
      "method": "POST",
      "path": "/api/auth/logout",
      "responses": {
        "200": {
          "description": "Session invalidated",
          "body": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "example": "success" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "me": {
      "method": "GET",
      "path": "/api/auth/me",
      "responses": {
        "200": {
          "description": "Current active session user",
          "body": {
            "type": "object",
            "properties": {
              "authenticated": { "type": "boolean" },
              "user": { "type": "object" }
            }
          }
        },
        "401": {
          "description": "Unauthenticated"
        }
      }
    }
  }
}
